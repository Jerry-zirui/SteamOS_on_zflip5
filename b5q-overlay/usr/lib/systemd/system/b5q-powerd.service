[Unit]
Description=Samsung Galaxy Z Flip 5 fanless power, thermal & refresh daemon
Before=display-manager.service steamos-manager.service
After=dbus.service

[Service]
Type=dbus
BusName=org.steamos_arm.Power
ExecStart=/usr/lib/steamos-arm/b5q-powerd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
