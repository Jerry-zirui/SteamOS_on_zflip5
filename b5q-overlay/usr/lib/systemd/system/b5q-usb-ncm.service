[Unit]
Description=Z Flip 5 USB CDC-NCM rescue network (usb0 172.16.42.1/24)
After=systemd-udevd.service network-pre.target
Before=NetworkManager.service sshd.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'ip link show usb0 >/dev/null 2>&1 && { ip addr replace 172.16.42.1/24 dev usb0 || true; ip link set usb0 up || true; }; exit 0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
