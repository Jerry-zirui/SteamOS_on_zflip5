#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Band-aware Wi-Fi / Bluetooth coexistence tuning for Samsung Galaxy Z Flip 5 (WCN6855).
# - 2.4 GHz: enable STA power-save windows and cap TX power at 12 dBm to cut shared-antenna
#   bleed into Bluetooth (empirically +82% BLE packet reception, 0 invalid RSSI frames, 0% ping loss).
# - 5 GHz / 6 GHz: full unthrottled performance (power_save off, txpower auto).
IFACE="${1:-}"
ACTION="${2:-}"
[ "$IFACE" = "wlan0" ] || exit 0

case "$ACTION" in
    up|dhcp4-change|connectivity-change) ;;
    *) exit 0 ;;
esac

FREQ="$(iw dev wlan0 info 2>/dev/null | sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz).*/\1/p' | head -n 1)"
[ -n "$FREQ" ] || exit 0

if [ "$FREQ" -ge 2400 ] && [ "$FREQ" -le 2499 ]; then
    iw dev wlan0 set power_save on 2>/dev/null || true
    iw dev wlan0 set txpower limit 1200 2>/dev/null || true
elif [ "$FREQ" -ge 5000 ]; then
    iw dev wlan0 set power_save off 2>/dev/null || true
    iw dev wlan0 set txpower auto 2>/dev/null || true
fi
exit 0
